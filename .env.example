# ==============================================================================
# Ads MCP by: noti.vn — biến môi trường
# Sao chép thành .env rồi điền. Có thể sinh tự động: node scripts/gen-env.mjs
# Sinh secret thủ công: openssl rand -base64 32
# docker-compose.yml chỉ truyền vào app các biến có trong danh sách của nó (x-env-runtime / x-env-web): biến tự
# thêm vào file này mà không có trong danh sách sẽ KHÔNG tới được app.
# ==============================================================================

# Tên miền chạy web (Caddy tự xin HTTPS). Domain cần bản ghi A (IPv4); phương án D (Cloudflare Tunnel): Cloudflare
# tự tạo bản ghi CNAME tới tunnel, không cần bản ghi A.
APP_DOMAIN=mcp.example.com
# Email đăng ký chứng chỉ Let's Encrypt (phương án A). Phương án khác vẫn phải có giá trị (không dùng tới).
ACME_EMAIL=ops@example.com
# URL công khai đầy đủ (dev: http://localhost:3000)
BETTER_AUTH_URL=https://mcp.example.com

# PostgreSQL (gen-env.mjs sinh ngẫu nhiên). Điền tay: POSTGRES_PASSWORD=<chuỗi ngẫu nhiên> và
# DATABASE_URL=postgres://adsmcp:<cùng mật khẩu>@db:5432/adsmcp
POSTGRES_PASSWORD=
DATABASE_URL=

# Ký cookie + mã hoá secret 2FA của Better Auth (32 byte base64)
BETTER_AUTH_SECRET=

# Khoá mã hoá token quảng cáo: "phiên_bản:khoá_base64_32_byte", khoá đầu tiên đang dùng.
# !!! SAO LƯU RIÊNG, KHÔNG để chung với file backup DB. Mất khoá = mất toàn bộ token đã lưu.
ENCRYPTION_KEYS=1:

# Pepper để băm key MCP (32 byte base64). Đổi giá trị này = mọi link MCP cũ ngừng hoạt động.
MCP_KEY_PEPPER=

# Mã dùng một lần để mở trang /setup tạo Admin đầu tiên (vô hiệu khi đã có người dùng)
SETUP_TOKEN=

# Số tháng lưu nhật ký khởi tạo (sau đó chỉnh trong Cài đặt)
LOG_RETENTION_MONTHS=3
# Múi giờ hiển thị và lịch chạy job
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Phiên bản API nền tảng (để trống = mặc định của ứng dụng)
META_API_VERSION=v26.0
GOOGLE_ADS_API_VERSION=v25
TIKTOK_API_VERSION=v1.3
OPENAI_ADS_API_VERSION=v1
# Máy chủ TikTok API (mặc định production). Chỉ đặt khi thử với sandbox: https://sandbox-ads.tiktok.com/open_api
# TIKTOK_BASE_URL=

# Giữ kết nối lâu hơn keepalive 2 phút của Caddy
KEEP_ALIVE_TIMEOUT=130000

# --- HTTPS / reverse proxy (docs/deploy-vps.md, mục "Chọn phương án SSL") ---------------------------------------
# gen-env.mjs --ssl <auto|cloudflare|nginx|tunnel> điền sẵn. Đổi phương án sau khi cài: sửa các dòng dưới rồi
#   docker compose up -d --no-build
# A auto (mặc định)  : Caddy tự xin chứng chỉ Let's Encrypt     -> CADDY_REPLICAS=1, CADDY_CLIENT_IP=direct, CADDY_TLS=auto
# B cloudflare        : sau proxy Cloudflare (mây cam), chứng chỉ Origin CA ở deploy/caddy/certs/
#                       -> CADDY_CLIENT_IP=cloudflare, CADDY_TLS=cloudflare-origin (hoặc cloudflare-origin-aop)
# C nginx             : Nginx + Certbot trên máy chủ            -> CADDY_REPLICAS=0, WEB_HOST_PORT=3000
# D tunnel            : Cloudflare Tunnel (cloudflared), VPS không mở 80/443
#                       -> CLOUDFLARED_REPLICAS=1, TUNNEL_TOKEN=<token>, CADDY_CLIENT_IP=tunnel, CADDY_TLS=tunnel,
#                          CADDY_SITE_SCHEME=http://, CADDY_HTTP_PORT_BIND=127.0.0.1:, CADDY_HTTPS_PORT_BIND=127.0.0.1:
# 1 = chạy Caddy, 0 = tắt Caddy (nhường cổng 80/443 cho Nginx).
CADDY_REPLICAS=1
# Cách lấy IP thật của khách: direct (khách kết nối thẳng) | cloudflare (tin CF-Connecting-IP từ dải IP Cloudflare)
# | tunnel (tin CF-Connecting-IP từ cloudflared trong mạng Docker; CHỈ dùng khi Caddy không mở cổng ra Internet).
# SAI giá trị này thì khoá đăng nhập / giới hạn MCP / allowlist IP áp theo IP của Cloudflare thay vì của khách.
CADDY_CLIENT_IP=direct
# Chứng chỉ: auto (Caddy tự xin) | cloudflare-origin | cloudflare-origin-aop | tunnel (không chứng chỉ, Cloudflare lo
# HTTPS) - file trong deploy/caddy/tls-*.caddy.
CADDY_TLS=auto
# Trống = site HTTPS (A, B). http:// = site chỉ HTTP trong mạng Docker (D, bắt buộc đi kèm CADDY_TLS=tunnel).
CADDY_SITE_SCHEME=
# Cổng Caddy mở trên máy chủ, dạng [IP:]cổng. Mặc định 80 / 443 = mọi địa chỉ (A, B).
# D: 127.0.0.1: (chỉ loopback, cổng ngẫu nhiên) để Caddy không nhận kết nối từ Internet.
CADDY_HTTP_PORT_BIND=80
CADDY_HTTPS_PORT_BIND=443
# Cổng của web trên 127.0.0.1 máy chủ (chỉ máy chủ truy cập được). Trống = cổng ngẫu nhiên (không dùng tới).
# Phương án C (Nginx): 3000 - khớp `server 127.0.0.1:3000` trong deploy/nginx/ads-mcp.conf.
WEB_HOST_PORT=

# --- Phương án D: Cloudflare Tunnel (docs/deploy-vps.md mục "Phương án D") --------------------------------------
# 1 = chạy service cloudflared, 0 = tắt (mặc định).
CLOUDFLARED_REPLICAS=0
# Token của tunnel (chuỗi eyJ... trong lệnh cài đặt ở dashboard Cloudflare: Networking -> Tunnels). Là SECRET:
# ai có token đều chạy được tunnel của bạn. Không gửi qua chat/email, không commit; lộ thì Rotate token trong dashboard.
TUNNEL_TOKEN=
# Giao thức tới Cloudflare: auto (mặc định, QUIC rồi lùi về http2) | http2 (mạng chặn UDP 7844 / kết nối hay rớt).
# CLOUDFLARED_PROTOCOL=auto

# --- Cập nhật tự động (admin bấm "Cập nhật" trong web; xem .claude/docs/07-deployment.md §6) -------------
# Bật service "updater" (có mount docker.sock, chỉ service này). Xoá/để trống dòng này để TẮT, rồi chạy:
#   docker compose rm -sf updater
# Khi tắt, web vẫn báo có bản mới nhưng hiện lệnh để cập nhật tay.
COMPOSE_PROFILES=updater
# Đường dẫn TUYỆT ĐỐI của thư mục dự án trên máy chủ (nơi có docker-compose.yml), ví dụ /opt/ads-mcp.
# gen-env.mjs tự điền; để trống thì dùng thư mục hiện tại của shell chạy docker compose.
HOST_PROJECT_DIR=
# Phiên bản image đang chạy (vd 1.0.2, KHÔNG có "v"; phải là bản đã phát hành trên trang Releases). BẮT BUỘC:
# trống thì mọi lệnh docker compose báo lỗi. gen-env.mjs điền theo package.json lúc cài; updater tự ghi khi cập nhật
# (giữ bản gốc ở .env.bak).
APP_VERSION=
# Repo GitHub kiểm tra bản mới (mặc định notivn/Ads-MCP-simple). Repo RIÊNG TƯ: bắt buộc đặt token = "Token B" của
# README bước 1 (PAT classic, chỉ tích `repo`, của tài khoản GitHub được noti.vn cấp quyền Read). Chỉ web + worker
# nhận biến này; token KHÔNG hiện trong web/log. Không dùng chung token với docker login (Token A: read:packages).
# UPDATE_REPO=notivn/Ads-MCP-simple
# UPDATE_GITHUB_TOKEN=
# Thông báo hệ thống (chạy chữ trên thanh trên cùng + kèm kết quả trong chat AI). Worker gọi 1 giờ/lần.
# Không đặt = dùng webhook của noti.vn. Đặt rỗng hoặc "off" để tắt hẳn. Chỉ nhận URL https://.
# SYSTEM_NOTICES_URL=
# Kênh thông báo Telegram: địa chỉ Bot API (mặc định https://api.telegram.org). Chỉ đổi khi tự chạy Telegram Bot API
# server riêng. Bắt buộc https:// (http chỉ cho localhost). Web + worker đọc biến này.
# TELEGRAM_API_BASE_URL=
# Tên image (không kèm tag) nếu dùng bản fork; updater cũng đọc biến này.
# APP_IMAGE=ghcr.io/notivn/ads-mcp-simple
# Thư mục chứa docker login ghcr.io (chỉ cần khi image riêng tư và đăng nhập bằng user khác root).
# UPDATER_DOCKER_CONFIG=/root/.docker
# Updater xác minh chữ ký số (cosign) của image noti.vn trước khi cập nhật (cần ra Internet tới Sigstore).
# 0 = bỏ qua bước này (KHÔNG khuyến nghị; chỉ dùng tạm khi máy chủ bị chặn mạng tới Sigstore).
# UPDATER_VERIFY_SIGNATURE=0

# --- Giới hạn tài nguyên container (tuỳ chọn; là mức trần, không phải mức giữ trước) -------------------------
# Đặt quá thấp container bị tắt vì hết bộ nhớ (updater tự quay về bản cũ nếu web/worker không chạy được).
# WEB_MEM_LIMIT=1g
# WORKER_MEM_LIMIT=768m
# MIGRATE_MEM_LIMIT=768m
# UPDATER_MEM_LIMIT=512m
# CADDY_MEM_LIMIT=256m
# CLOUDFLARED_MEM_LIMIT=256m
# WEB_PIDS_LIMIT=512
# WORKER_PIDS_LIMIT=256
